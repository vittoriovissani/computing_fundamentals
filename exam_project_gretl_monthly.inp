# ==============================================================================
# GRETL EXAM PROJECT (TIME SERIES) - EU FURNITURE PROCUREMENT (CPV 391)
# MONTHLY VERSION
# ==============================================================================
#
# Narrative (keep it simple):
# 1) Market activity and size over time (n_lots, total_value)
# 2) Competition structure: many lots have 1 bid -> share_one_bid
# 3) Does low competition correlate with higher prices? (avg_lot_price)
#
# Dataset: furniture_monthly_ts.csv (generated by extract_timeseries_v3.py)
# Period: 2008M04 ... 2024M04 (monthly, 191 observations)
# ==============================================================================

set verbose off

# -----------------------------------------------------------------------------
# 1) Load and define time series
# -----------------------------------------------------------------------------

open furniture_monthly_ts.csv
setobs 12 2008:4 --time-series

print "EU furniture procurement (CPV 391) - monthly time series"
print ""

# Keep printed output minimal
summary n_lots total_value avg_lot_price avg_bids share_one_bid

# Plot 1: activity + market size
# (two core series to explain what happens in the market)
gnuplot n_lots total_value --time-series --with-lines --output=display { \
    set title "Activity and market size (monthly)"; \
}

# -----------------------------------------------------------------------------
# 2) Competition: are one-bid lots common?
# -----------------------------------------------------------------------------

# Plot 2: competition indicators
gnuplot avg_bids share_one_bid --time-series --with-lines --output=display { \
    set title "Competition indicators: avg bids vs share of one-bid lots"; \
}

# A couple of key numbers the examiner can ask about
scalar mean_onebid = mean(share_one_bid)
scalar max_onebid = max(share_one_bid)
scalar min_onebid = min(share_one_bid)

print ""
print "Key competition facts (share of lots with exactly 1 bid)"
printf "mean share_one_bid: %.3f\n", mean_onebid
printf "min  share_one_bid: %.3f\n", min_onebid
printf "max  share_one_bid: %.3f\n", max_onebid

# -----------------------------------------------------------------------------
# 3) Price vs competition: simple, explainable relationship
# -----------------------------------------------------------------------------

# Use logs to reduce scale effects and interpret coefficients more easily
series l_price = log(avg_lot_price)

# Plot 3: price trend (one line)
gnuplot l_price --time-series --with-lines --output=display { \
    set title "Log average winning lot price (monthly)"; \
}

# Regression (simple narrative):
# Does a higher share of one-bid lots associate with higher prices?
# (We add a linear trend to avoid spurious correlation.)
series t = time

print ""
print "Model: log(avg_lot_price) = f(share_one_bid, t)"
ols l_price const share_one_bid t

# Optional: alternative competition measure (avg_bids)
print ""
print "Model: log(avg_lot_price) = f(avg_bids, t)"
ols l_price const avg_bids t

# -----------------------------------------------------------------------------
# 4) One simple structural break example (COVID)
# -----------------------------------------------------------------------------

# Dummy from 2020M03 onward (first COVID lockdowns in Europe)
# 2008M04 = obs 1, so 2020M03 = 1 + (2020-2008)*12 - 1 = 144
series covid = (t >= 144) ? 1 : 0

print ""
print "Model with COVID dummy: log(avg_lot_price) = f(share_one_bid, t, covid)"
ols l_price const share_one_bid t covid

# =============================================================================
# 5) ANALISI AVANZATE: Scomposizione e Stazionarietà
# =============================================================================

print ""
print "========== ANALISI AVANZATE =========="

# -----------------------------------------------------------------------------
# 5a) SCOMPOSIZIONE DELLA SERIE (Detrending)
# -----------------------------------------------------------------------------
# Scomponiamo total_value in: Trend + Ciclo + Residuo
# Usiamo un filtro HP (Hodrick-Prescott) per estrarre il trend

print ""
print "--- Scomposizione HP di total_value ---"

# Filtro Hodrick-Prescott (lambda=14400 per dati mensili)
series tv_trend = hpfilt(total_value, 14400)
series tv_cycle = total_value - tv_trend

# Plot: serie originale vs trend
gnuplot total_value tv_trend --time-series --with-lines --output=display { \
    set title "Total Value: Serie vs Trend HP"; \
    set ylabel "EUR"; \
}

# Plot: componente ciclica
gnuplot tv_cycle --time-series --with-lines --output=display { \
    set title "Total Value: Componente Ciclica (deviazioni dal trend)"; \
    set ylabel "EUR"; \
    set y2tics; \
}

# Stessa analisi per avg_lot_price
print ""
print "--- Scomposizione HP di avg_lot_price ---"

series price_trend = hpfilt(avg_lot_price, 14400)
series price_cycle = avg_lot_price - price_trend

gnuplot avg_lot_price price_trend --time-series --with-lines --output=display { \
    set title "Avg Lot Price: Serie vs Trend HP"; \
    set ylabel "EUR"; \
}

gnuplot price_cycle --time-series --with-lines --output=display { \
    set title "Avg Lot Price: Componente Ciclica"; \
    set ylabel "EUR"; \
}

# -----------------------------------------------------------------------------
# 5b) TEST DI STAZIONARIETÀ (ADF - Augmented Dickey-Fuller)
# -----------------------------------------------------------------------------
print ""
print "--- Test ADF di Stazionarietà ---"

# Test ADF su avg_lot_price (livelli)
print "ADF test su avg_lot_price (livelli):"
adf 12 avg_lot_price --c

# Test ADF sulla componente ciclica (dovrebbe essere stazionaria)
print ""
print "ADF test sulla componente ciclica (price_cycle):"
adf 12 price_cycle --c

# Test ADF su share_one_bid
print ""
print "ADF test su share_one_bid:"
adf 12 share_one_bid --c

# -----------------------------------------------------------------------------
# 5c) REGRESSIONE CON CORREZIONE PER AUTOCORRELAZIONE
# -----------------------------------------------------------------------------
print ""
print "--- OLS con errori HAC (Newey-West) ---"
print "Corregge per autocorrelazione e eteroschedasticità"

# Regressione con errori standard robusti (HAC)
ols l_price const share_one_bid t --robust

# -----------------------------------------------------------------------------
# 5d) ANALISI SULLA COMPONENTE CICLICA (serie stazionarie)
# -----------------------------------------------------------------------------
print ""
print "--- Regressione sulle componenti cicliche ---"
print "Evita regressioni spurie usando serie detrendizzate"

series comp_cycle = hpfilt(share_one_bid, 14400)
series sob_cycle = share_one_bid - comp_cycle

ols price_cycle const sob_cycle

# -----------------------------------------------------------------------------
# 5e) STAGIONALITÀ MENSILE
# -----------------------------------------------------------------------------
print ""
print "--- Analisi Stagionalità Mensile ---"

# Crea dummy mensili
genr dummy_month = $obsminor
dummify dummy_month

# Regressione con dummy mensili
print "Modello con effetti fissi mensili:"
ols avg_lot_price const share_one_bid t Dmonth_* --robust

print ""
print "========== ANALISI COMPLETE =========="
print ""
print "PUNTI DI DISCUSSIONE:"
print "(1) Il filtro HP rivela un trend decrescente nei prezzi medi"
print "(2) La componente ciclica mostra fluttuazioni attorno al trend"
print "(3) Il test ADF indica se le serie sono stazionarie (I(0)) o integrate (I(1))"
print "(4) Gli errori HAC correggono per l'autocorrelazione nei residui OLS"
print "(5) L'analisi sulla componente ciclica evita regressioni spurie"
print "(6) Le dummy mensili catturano eventuali pattern stagionali"
